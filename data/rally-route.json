    },
    {
      "id": "place-01",
      "number": 8,
      "name": "Regenschirm – Bärplatz 2",
      "lat": 51.75063,
      "lng": 11.980231,
      "radiusMeters": 30,
      "hint": "Schutz vor Regen findest du unter mir, orange leuchte ich entgegen dir.",
      "sourceListIndex": 1,
      "locationVerifiedOnSite": false
    },
    {
      "id": "place-03",
      "number": 9,
      "name": "Rausch Reisen",
      "lat": 51.75116,
      "lng": 11.978212,
      "radiusMeters": 30,
      "hint": "Reist hinaus, wo neue Abenteuer warten,\nAuf unbekannten Wegen beginnt eure Fahrt.\nUnterwegs begegnet euch so manche Spur,\nSucht sie gut, denn sie führt euch weiter.\nClever müsst ihr sein, um sie zu entdecken,\nHaltet die Augen offen und folgt den ersten Zeichen.\n\nRichtung unbekannt, doch das Ziel ist nah,\nEilt nun weiter, Schritt für Schritt.\nIrgendwo wartet bereits die nächste Spur,\nSie führt euch weiter auf eurer Tour.\nEntdeckt, wohin der Weg euch bringt,\nNur wer genau liest, wird es erkennen.",
      "sourceListIndex": 3,
      "locationVerifiedOnSite": false,
      "hintLayout": "verse"
    },
    {
      "id": "place-18",
      "number": 10,
      "name": "Kugelbrunnen",
      "lat": 51.7513867,
      "lng": 11.977702,
      "radiusMeters": 30,
      "hint": "Folgt Tim und Struppi dem Weg der in Richtung Waffeln und Schokolade führt und nehmt die nächste links zum Ort wo  Riesen mit Murmeln spielen.",
      "sourceListIndex": 18,
      "locationVerifiedOnSite": false
    },
    {
