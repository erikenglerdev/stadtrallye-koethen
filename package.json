{
  "name": "scavenger-hunt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "npm run validate:config && npm run legal:notices",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright",
    "validate:config": "node --import tsx scripts/validate-config.ts",
    "test:rally": "node --import tsx --test tests/rally/*.test.ts",
    "lint:rally": "eslint --no-ignore src/rally/*.ts src/components/Rally/*.tsx src/app/api/rally/route.ts src/app/rallye/page.tsx tests/rally/*.test.ts src/components/Dashboard/*.tsx src/app/dashboard/page.tsx src/app/api/dashboard/route.ts",
    "legal:notices": "node scripts/generate-notices.mjs",
    "predev": "npm run legal:notices"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.2.7",
    "@fontsource/inter-tight": "^5.2.6",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "@types/leaflet": "^1.9.21",
    "@types/three": "^0.184.0",
    "bootstrap": "^5.3.7",
    "driver.js": "^1.4.0",
    "leaflet": "^1.9.4",
    "leaflet-geosearch": "^4.2.2",
    "next": "^16.2",
    "react": "^19.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.1",
    "react-leaflet": "^5.0.0",
    "react-pageflip": "^2.0.3",
    "three": "^0.184.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/dotenv": "^6.1.1",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "^16.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "CC-BY-NC-SA-4.0"
}
